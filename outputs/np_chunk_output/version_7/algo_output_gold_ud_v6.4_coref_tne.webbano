            },
            {
                "text": "ה",
                "start_index": 6193,
                "end_index": 6194,
                "id": 585
            },
            {
                "text": "נשיא שמרן",
                "start_index": 6206,
                "end_index": 6215,
                "id": 586
            },
            {
                "text": "לזלי לנקובסקי, אחד השותפים למזימה",
