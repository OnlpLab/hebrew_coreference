                "start_index": 3647,
                "end_index": 3648,
                "id": 338
            },
            {
                "text": "פוליטיקאים אמריקאיים",
                "start_index": 3653,
                "end_index": 3673,
                "id": 339
            },
            {
                "text": "חזקה על הארקין",
