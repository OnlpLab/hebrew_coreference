                "id": 164
            },
            {
                "text": "הוא",
                "start_index": 1826,
                "end_index": 1829,
                "id": 165
            },
            {
                "text": "השבוע",
                "start_index": 1835,
                "end_index": 1840,
                "id": 166
            },
            {
                "text": "הפרש של שני אחוזים",
                "start_index": 1842,
