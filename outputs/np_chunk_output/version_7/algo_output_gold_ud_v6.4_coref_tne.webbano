                "start_index": 6453,
                "end_index": 6460,
                "id": 609
            },
            {
                "text": "מגוון שלם של נושאים הראויים לבדיקה",
                "start_index": 6485,
                "end_index": 6519,
                "id": 610
            },
            {
                "text": "נושאים הראויים לבדיקה",
