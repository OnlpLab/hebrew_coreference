                "id": 153
            },
            {
                "text": "המודעות החברתית",
                "start_index": 1649,
                "end_index": 1664,
                "id": 154
            },
            {
                "text": "טד",
                "start_index": 1665,
                "end_index": 1667,
                "id": 155
            },
            {
                "text": "טרנר",
                "start_index": 1668,
                "end_index": 1672,
                "id": 156
            },
            {
                "text": "ההתאחדות לעולם טוב יותר\", המבקשת מענקים מקרנות",
                "start_index": 1688,
                "end_index": 1734,
                "id": 157
            },
            {
                "text": "עולם טוב יותר",
