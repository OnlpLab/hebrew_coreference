            },
            {
                "text": "טרנר",
                "start_index": 1927,
                "end_index": 1931,
                "id": 177
            },
            {
                "text": "הסרטים הדוקומנטריים",
                "start_index": 1935,
                "end_index": 1954,
                "id": 178
            },
            {
                "text": "רשת הטלוויזיה שלו הקיימת בהחלט",
                "start_index": 1956,
                "end_index": 1986,
                "id": 179
            },
            {
                "text": "הטלוויזיה",
