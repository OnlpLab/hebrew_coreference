            },
            {
                "text": "מספר 1",
                "start_index": 1086,
                "end_index": 1092,
                "id": 106
            },
            {
                "text": "גופים",
                "start_index": 1102,
                "end_index": 1107,
                "id": 107
            },
            {
                "text": "שבעה מיליארדי הדולרים שקרנות אמריקאיות מחלקות",
