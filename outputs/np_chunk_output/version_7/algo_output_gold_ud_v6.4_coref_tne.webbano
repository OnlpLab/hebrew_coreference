                "end_index": 6381,
                "id": 599
            },
            {
                "text": "עצמה",
                "start_index": 6377,
                "end_index": 6381,
                "id": 600
            },
            {
                "text": "חלופות לכל החשיבה השמאלית שקיבלה עד אז תגמולים ומימון",
                "start_index": 6393,
                "end_index": 6446,
                "id": 601
            },
            {
                "text": "כל החשיבה השמאלית שקיבלה עד אז תגמולים ומימון",
