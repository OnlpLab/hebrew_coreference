                "text": "סילבר",
                "start_index": 1862,
                "end_index": 1867,
                "id": 169
            },
            {
                "text": "הדמות הפוליטית המרתקת, המורכבת והמסוכנת ביותר במערכת הבחירות של 1990",
                "start_index": 1877,
                "end_index": 1945,
                "id": 170
            },
            {
                "text": "מערכת הבחירות של 1990",
                "start_index": 1924,
