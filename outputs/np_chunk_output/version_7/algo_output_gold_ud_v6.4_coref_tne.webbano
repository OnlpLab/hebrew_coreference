                "id": 146
            },
            {
                "text": "ך",
                "start_index": 1579,
                "end_index": 1580,
                "id": 147
            },
            {
                "text": "אחוז שמן מהמענק",
                "start_index": 1586,
                "end_index": 1601,
                "id": 148
            },
            {
                "text": "המענק",
                "start_index": 1596,
                "end_index": 1601,
                "id": 149
            },
            {
                "text": "הוצאות קבועות",
                "start_index": 1613,
                "end_index": 1626,
                "id": 150
            },
            {
                "text": "איל ההון בעל המודעות החברתית טד",
                "start_index": 1636,
                "end_index": 1667,
                "id": 151
            },
            {
                "text": "ההון",
                "start_index": 1640,
                "end_index": 1644,
                "id": 152
            },
            {
                "text": "בעל המודעות החברתית",
                "start_index": 1645,
