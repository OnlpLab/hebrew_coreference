                "id": 102
            },
            {
                "text": "ו",
                "start_index": 1064,
                "end_index": 1065,
                "id": 103
            },
            {
                "text": "כמה עצות",
                "start_index": 1072,
                "end_index": 1080,
                "id": 104
            },
            {
                "text": "עצה מספר 1",
                "start_index": 1082,
