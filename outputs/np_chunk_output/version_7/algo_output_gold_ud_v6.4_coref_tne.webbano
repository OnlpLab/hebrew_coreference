                "end_index": 6554,
                "id": 615
            },
            {
                "text": "רעיונות מעניינים",
                "start_index": 6558,
                "end_index": 6574,
                "id": 616
            },
            {
                "text": "בעלי",
                "start_index": 6591,
                "end_index": 6595,
                "id": 617
            },
            {
                "text": "הרעיונות המעניינים",
                "start_index": 6596,
                "end_index": 6614,
                "id": 618
            },
            {
                "text": "אנשים כמו רוברט בורק, מרטין פלדסטיין, צארלס מאריי ואלן בלום שגם הודות לתמיכה הפילנטרופית שקיבלו בשנות ה70 ואו בראשית שנות ה80 אין",
                "start_index": 6619,
                "end_index": 6748,
                "id": 619
            },
            {
                "text": "רוברט בורק, מרטין פלדסטיין, צארלס מאריי ואלן",
                "start_index": 6629,
                "end_index": 6673,
                "id": 620
            },
            {
                "text": "רוברט",
                "start_index": 6629,
                "end_index": 6634,
                "id": 621
            },
            {
                "text": "בורק",
                "start_index": 6635,
                "end_index": 6639,
                "id": 622
            },
            {
                "text": "מרטין",
                "start_index": 6641,
                "end_index": 6646,
                "id": 623
            },
            {
                "text": "פלדסטיין",
                "start_index": 6647,
                "end_index": 6655,
                "id": 624
            },
            {
                "text": "צארלס",
                "start_index": 6657,
                "end_index": 6662,
                "id": 625
            },
            {
                "text": "מאריי",
                "start_index": 6663,
                "end_index": 6668,
                "id": 626
            },
            {
                "text": "אלן",
                "start_index": 6670,
                "end_index": 6673,
                "id": 627
            },
            {
                "text": "בלום",
                "start_index": 6674,
                "end_index": 6678,
                "id": 628
            },
            {
                "text": "תמיכה הפילנטרופית שקיבלו בשנות",
                "start_index": 6690,
                "end_index": 6720,
                "id": 629
            },
            {
                "text": "שנות",
                "start_index": 6716,
                "end_index": 6720,
                "id": 630
            },
            {
                "text": "ראשית",
                "start_index": 6730,
                "end_index": 6735,
                "id": 631
            },
            {
                "text": "שנות",
                "start_index": 6736,
                "end_index": 6740,
                "id": 632
            },
            {
                "text": "צורך להציגם בציבור",
