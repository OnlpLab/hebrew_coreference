                "id": 635
            },
            {
                "text": "אתה",
                "start_index": 6772,
                "end_index": 6775,
                "id": 636
            },
            {
                "text": "השמרנים",
                "start_index": 6789,
                "end_index": 6796,
                "id": 637
            },
            {
