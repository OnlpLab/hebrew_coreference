                "id": 210
            },
            {
                "text": "זפה",
                "start_index": 1898,
                "end_index": 1901,
                "id": 211
            },
            {
                "text": "חוסר הרצון הפוליטי להביא לידי בירור את שלוש הפרשיות של בוסקה, פאפון וטובייה",
                "start_index": 1907,
