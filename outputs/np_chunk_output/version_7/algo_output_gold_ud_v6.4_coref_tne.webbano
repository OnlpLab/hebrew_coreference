                "id": 158
            },
            {
                "text": "מענקים",
                "start_index": 1721,
                "end_index": 1727,
                "id": 159
            },
            {
                "text": "קרנות",
                "start_index": 1729,
                "end_index": 1734,
                "id": 160
            },
            {
                "text": "סרטי טלוויזיה דוקומנטריים",
                "start_index": 1745,
                "end_index": 1770,
                "id": 161
            },
            {
                "text": "טלוויזיה",
                "start_index": 1750,
