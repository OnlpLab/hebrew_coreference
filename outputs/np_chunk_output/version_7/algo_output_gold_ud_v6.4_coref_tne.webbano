                "id": 132
            },
            {
                "text": "הוא",
                "start_index": 1514,
                "end_index": 1517,
                "id": 133
            },
            {
                "text": "ידיד, המנסה להכשילם",
                "start_index": 1518,
                "end_index": 1537,
                "id": 134
            },
            {
                "text": "ם",
