            },
            {
                "text": "חודשיים",
                "start_index": 3968,
                "end_index": 3975,
                "id": 351
            },
            {
                "text": "סיבה טובה להניח שגורג בוש יהיה המקרה החמישי",
                "start_index": 3984,
                "end_index": 4027,
                "id": 352
            },
            {
                "text": "גורג בוש",
                "start_index": 4001,
