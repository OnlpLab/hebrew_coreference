                "start_index": 8967,
                "end_index": 8977,
                "id": 835
            },
            {
                "text": "צפון",
                "start_index": 8967,
                "end_index": 8971,
                "id": 836
            },
            {
                "text": "דרום",
                "start_index": 8973,
                "end_index": 8977,
                "id": 837
            },
            {
                "text": "תלות הדדית",
                "start_index": 8984,
                "end_index": 8994,
                "id": 838
            },
            {
                "text": "הרבה כסף",
                "start_index": 8998,
                "end_index": 9006,
                "id": 839
            },
            {
                "text": "הגות על מדינות",
