                "start_index": 9058,
                "end_index": 9066,
                "id": 846
            },
            {
                "text": "רונלד",
                "start_index": 9068,
                "end_index": 9073,
                "id": 847
            },
            {
                "text": "רייגן",
                "start_index": 9074,
                "end_index": 9079,
                "id": 848
            },
            {
                "text": "נאום",
                "start_index": 9081,
                "end_index": 9085,
                "id": 849
            },
            {
                "text": "אימפריית",
                "start_index": 9086,
                "end_index": 9094,
                "id": 850
            },
            {
                "text": "הרשע",
                "start_index": 9095,
                "end_index": 9099,
                "id": 851
            },
            {
                "text": "הנושא החם ביחסים הבין-לאומיים",
                "start_index": 9119,
                "end_index": 9148,
                "id": 852
            },
            {
                "text": "יחסים הבין-לאומיים",
                "start_index": 9130,
                "end_index": 9148,
                "id": 853
            },
            {
                "text": "תלות הדדית גלובלית, אלא ביטחון לאומי",
                "start_index": 9149,
                "end_index": 9185,
                "id": 854
            },
            {
                "text": "תלות הדדית גלובלית",
                "start_index": 9149,
                "end_index": 9167,
                "id": 855
            },
            {
                "text": "ביטחון לאומי",
                "start_index": 9173,
                "end_index": 9185,
                "id": 856
            },
            {
                "text": "הקרנות הלא-שמרניות",
                "start_index": 9187,
                "end_index": 9205,
                "id": 857
            },
            {
                "text": "אלה שפרסמו מחקרים לאין-ספור בשאלה כיצד לשמור על השלום",
                "start_index": 9216,
                "end_index": 9269,
                "id": 858
            },
            {
                "text": "אלה",
                "start_index": 9216,
                "end_index": 9219,
                "id": 859
            },
            {
                "text": "מחקרים לאין-ספור בשאלה כיצד לשמור על השלום",
                "start_index": 9227,
                "end_index": 9269,
                "id": 860
            },
            {
                "text": "שאלה כיצד לשמור על השלום",
                "start_index": 9245,
                "end_index": 9269,
                "id": 861
            },
            {
                "text": "השלום",
                "start_index": 9264,
                "end_index": 9269,
                "id": 862
            },
            {
                "text": "המלחמה הקרה",
                "start_index": 9280,
                "end_index": 9291,
                "id": 863
            },
            {
                "text": "כולם",
                "start_index": 9304,
                "end_index": 9308,
                "id": 864
            },
            {
                "text": "משפטים ומטבעות לשון חדשים שילכדו את תשומת",
                "start_index": 9315,
                "end_index": 9356,
                "id": 865
            },
            {
                "text": "מטבעות",
                "start_index": 9323,
                "end_index": 9329,
                "id": 866
            },
            {
                "text": "לשון",
                "start_index": 9330,
                "end_index": 9334,
                "id": 867
            },
            {
                "text": "תשומת",
                "start_index": 9351,
                "end_index": 9356,
                "id": 868
            },
            {
                "text": "לבם של פקידי",
                "start_index": 9357,
                "end_index": 9369,
                "id": 869
            },
