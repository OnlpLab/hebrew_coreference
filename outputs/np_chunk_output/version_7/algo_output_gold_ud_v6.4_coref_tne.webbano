                "start_index": 1780,
                "end_index": 1787,
                "id": 160
            },
            {
                "text": "אנשים",
                "start_index": 1792,
                "end_index": 1797,
                "id": 161
            },
            {
                "text": "ניצחונו של סילבר",
                "start_index": 1808,
