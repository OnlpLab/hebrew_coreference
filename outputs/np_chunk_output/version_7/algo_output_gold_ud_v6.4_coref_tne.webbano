                "id": 162
            },
            {
                "text": "אתה",
                "start_index": 1775,
                "end_index": 1778,
                "id": 163
            },
            {
                "text": "איש",
                "start_index": 1795,
                "end_index": 1798,
                "id": 164
            },
            {
                "text": "ביניים",
                "start_index": 1799,
                "end_index": 1805,
                "id": 165
            },
            {
                "text": "אתה",
                "start_index": 1807,
                "end_index": 1810,
                "id": 166
            },
            {
                "text": "ארגון משלך שלא למטרות",
                "start_index": 1822,
                "end_index": 1843,
                "id": 167
            },
            {
                "text": "ך",
                "start_index": 1831,
                "end_index": 1832,
                "id": 168
            },
            {
                "text": "מטרות",
                "start_index": 1838,
                "end_index": 1843,
                "id": 169
            },
            {
                "text": "רווח",
                "start_index": 1844,
                "end_index": 1848,
                "id": 170
            },
            {
                "text": "מימון פטור",
                "start_index": 1869,
                "end_index": 1879,
                "id": 171
            },
            {
                "text": "מס",
                "start_index": 1881,
                "end_index": 1883,
                "id": 172
            },
            {
                "text": "ההתאחדות שלו שלא למטרות",
