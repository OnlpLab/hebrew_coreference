                "id": 595
            },
            {
                "text": "בוש",
                "start_index": 6717,
                "end_index": 6720,
                "id": 596
            },
            {
                "text": "ימים",
                "start_index": 6726,
                "end_index": 6730,
                "id": 597
            },
            {
                "text": "ההתקפה ההיא",
                "start_index": 6734,
                "end_index": 6745,
                "id": 598
            },
            {
                "text": "היא",
                "start_index": 6742,
                "end_index": 6745,
                "id": 599
            },
            {
                "text": "ו",
                "start_index": 6752,
                "end_index": 6753,
                "id": 600
            },
            {
                "text": "הנחישות להשיב לדמוקרטים במתקפת נגד, שזכר תוקפנותה מעורר עד עכשיו אי-נוחות ניכרת בין משקיפים פוליטים",
                "start_index": 6757,
                "end_index": 6856,
                "id": 601
            },
            {
                "text": "דמוקרטים",
                "start_index": 6772,
                "end_index": 6780,
                "id": 602
            },
            {
                "text": "מתקפת נגד, שזכר תוקפנותה מעורר עד עכשיו אי-נוחות ניכרת בין משקיפים פוליטים",
                "start_index": 6782,
                "end_index": 6856,
                "id": 603
            },
            {
                "text": "נגד",
                "start_index": 6788,
                "end_index": 6791,
                "id": 604
            },
            {
                "text": "זכר תוקפנותה",
                "start_index": 6794,
                "end_index": 6806,
                "id": 605
            },
            {
                "text": "תוקפנותה",
                "start_index": 6798,
                "end_index": 6806,
                "id": 606
            },
            {
                "text": "ה",
                "start_index": 6805,
                "end_index": 6806,
                "id": 607
            },
            {
                "text": "נוחות ניכרת בין משקיפים פוליטים",
                "start_index": 6825,
                "end_index": 6856,
                "id": 608
            },
            {
                "text": "משקיפים פוליטים",
                "start_index": 6841,
                "end_index": 6856,
                "id": 609
            },
            {
                "text": "ריצארדס",
                "start_index": 6867,
                "end_index": 6874,
                "id": 610
            },
            {
                "text": "דמות שנויה",
                "start_index": 6875,
                "end_index": 6885,
                "id": 611
            },
            {
                "text": "מחלוקת",
                "start_index": 6887,
                "end_index": 6893,
                "id": 612
            },
            {
                "text": "מועמדות מפלגתה למושל",
                "start_index": 6918,
                "end_index": 6938,
                "id": 613
            },
            {
                "text": "מפלגתה",
                "start_index": 6926,
