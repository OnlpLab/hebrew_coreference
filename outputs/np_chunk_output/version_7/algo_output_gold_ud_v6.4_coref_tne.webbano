                "id": 465
            },
            {
                "text": "עצמו, כך או אחרת, מועמד פוטנציאלי לנשיאות",
                "start_index": 5227,
                "end_index": 5268,
                "id": 466
            },
            {
                "text": "עצמו",
                "start_index": 5227,
                "end_index": 5231,
                "id": 467
            },
            {
                "text": "מועמד פוטנציאלי לנשיאות",
                "start_index": 5245,
