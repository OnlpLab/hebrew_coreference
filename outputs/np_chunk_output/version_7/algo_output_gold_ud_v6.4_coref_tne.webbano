                "text": "ך",
                "start_index": 6956,
                "end_index": 6957,
                "id": 655
            },
            {
                "text": "הקרנות השמרניות אולין, סמית-ריצרדסון, לינד והרי בראדלו, פיו, שרה",
                "start_index": 6964,
                "end_index": 7028,
                "id": 656
            },
            {
                "text": "אולין, סמית-ריצרדסון, לינד והרי בראדלו, פיו, שרה",
                "start_index": 6980,
                "end_index": 7028,
                "id": 657
            },
            {
                "text": "אולין",
                "start_index": 6980,
                "end_index": 6985,
                "id": 658
            },
            {
                "text": "סמית",
                "start_index": 6987,
                "end_index": 6991,
                "id": 659
            },
            {
                "text": "ריצרדסון",
                "start_index": 6992,
                "end_index": 7000,
                "id": 660
            },
            {
