                "start_index": 8719,
                "end_index": 8723,
                "id": 813
            },
            {
                "text": "מוסדות כמו ברוקינגס",
                "start_index": 8735,
                "end_index": 8754,
                "id": 814
            },
            {
                "text": "ברוקינגס",
                "start_index": 8746,
                "end_index": 8754,
                "id": 815
            },
            {
                "text": "עיניהם",
                "start_index": 8758,
                "end_index": 8764,
                "id": 816
            },
            {
                "text": "הם",
                "start_index": 8762,
                "end_index": 8764,
                "id": 817
            },
            {
                "text": "קרנות שמרניות",
                "start_index": 8766,
