                "id": 5
            },
            {
                "text": "500 ש\"ח",
                "start_index": 76,
                "end_index": 83,
                "id": 6
            },
            {
                "text": "שכר הרגיל",
                "start_index": 91,
                "end_index": 100,
                "id": 7
            },
            {
