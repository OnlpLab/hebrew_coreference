    {
        "nps": [
            {
                "text": "זהו",
                "start_index": 6,
                "end_index": 9,
                "id": 0
            },
            {
                "text": "כישלונו היחיד עד כה של המפכ\"ל, שנגרם רק בגלל העובדה שהוא סמך יותר מדי על קציניו הבכירים",
                "start_index": 10,
                "end_index": 97,
                "id": 1
            },
            {
                "text": "ו",
                "start_index": 16,
                "end_index": 17,
                "id": 2
            },
            {
                "text": "המפכ\"ל",
                "start_index": 33,
                "end_index": 39,
                "id": 3
            },
            {
                "text": "העובדה שהוא סמך יותר מדי על קציניו הבכירים",
                "start_index": 55,
                "end_index": 97,
                "id": 4
            },
            {
                "text": "הוא",
                "start_index": 63,
                "end_index": 66,
                "id": 5
            },
            {
                "text": "קציניו הבכירים",
                "start_index": 83,
                "end_index": 97,
                "id": 6
            },
            {
                "text": "ו",
                "start_index": 88,
                "end_index": 89,
                "id": 7
            },
            {
                "text": "כל נושא",
                "start_index": 102,
                "end_index": 109,
                "id": 8
            },
            {
                "text": "משרה",
                "start_index": 110,
                "end_index": 114,
                "id": 9
            },
            {
                "text": "השגיאה הראשונה",
                "start_index": 128,
                "end_index": 142,
                "id": 10
            },
            {
                "text": "המדינה",
                "start_index": 150,
                "end_index": 156,
                "id": 11
            },
            {
                "text": "סבב בלתי פוסק של בעלי תפקידים בכירים, חסרי ניסיון וחסרי",
                "start_index": 158,
                "end_index": 213,
                "id": 12
            },
            {
                "text": "בעלי תפקידים בכירים, חסרי ניסיון וחסרי",
                "start_index": 175,
                "end_index": 213,
                "id": 13
            },
