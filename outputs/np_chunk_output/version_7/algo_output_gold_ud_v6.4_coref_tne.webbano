                "id": 648
            },
            {
                "text": "עולם",
                "start_index": 6877,
                "end_index": 6881,
                "id": 649
            },
            {
                "text": "הרעיונות",
                "start_index": 6882,
                "end_index": 6890,
                "id": 650
            },
            {
                "text": "הם",
                "start_index": 6892,
                "end_index": 6894,
                "id": 651
            },
            {
                "text": "ך",
                "start_index": 6903,
                "end_index": 6904,
                "id": 652
            },
            {
                "text": "רשימת",
                "start_index": 6906,
                "end_index": 6911,
                "id": 653
            },
            {
                "text": "הקרנות הפילנטרופיות הגדולות ביותר",
                "start_index": 6912,
                "end_index": 6945,
                "id": 654
            },
