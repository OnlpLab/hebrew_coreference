                "start_index": 1912,
                "end_index": 1917,
                "id": 213
            },
            {
                "text": "בירור",
                "start_index": 1937,
                "end_index": 1942,
                "id": 214
            },
            {
                "text": "שלוש הפרשיות של בוסקה, פאפון וטובייה",
                "start_index": 1946,
                "end_index": 1982,
                "id": 215
            },
            {
                "text": "בוסקה, פאפון וטובייה",
