                "text": "המנזר",
                "start_index": 1300,
                "end_index": 1305,
                "id": 115
            },
            {
                "text": "חוסר",
                "start_index": 1320,
                "end_index": 1324,
                "id": 116
            },
            {
                "text": "הבנה אסטרטגית וטקטית בסוגיה זו",
                "start_index": 1325,
                "end_index": 1355,
                "id": 117
            },
            {
                "text": "סוגיה זו",
                "start_index": 1347,
                "end_index": 1355,
                "id": 118
            },
            {
                "text": "היא",
                "start_index": 1357,
                "end_index": 1360,
                "id": 119
            },
            {
                "text": "אותו קרב המגננה שבו אירעו",
                "start_index": 1371,
                "end_index": 1396,
                "id": 120
            },
            {
                "text": "המגננה",
                "start_index": 1380,
                "end_index": 1386,
                "id": 121
            },
            {
                "text": "ו",
                "start_index": 1389,
                "end_index": 1390,
                "id": 122
            },
            {
                "text": "מעשי גבורה עילאיים",
                "start_index": 1397,
                "end_index": 1415,
                "id": 123
            },
            {
                "text": "גבורה",
                "start_index": 1402,
                "end_index": 1407,
                "id": 124
            },
            {
                "text": "קבלת החלטות קשות בתנאי",
                "start_index": 1421,
                "end_index": 1443,
                "id": 125
            },
            {
                "text": "החלטות קשות",
                "start_index": 1426,
                "end_index": 1437,
                "id": 126
            },
            {
                "text": "תנאי",
                "start_index": 1439,
                "end_index": 1443,
                "id": 127
            },
            {
                "text": "קרב",
                "start_index": 1444,
                "end_index": 1447,
                "id": 128
            },
            {
                "text": "מורשת הקרב שצה\"ל אימץ כתוצאה מהקרב על מנזר",
                "start_index": 1449,
                "end_index": 1491,
                "id": 129
            },
            {
                "text": "הקרב",
                "start_index": 1455,
                "end_index": 1459,
                "id": 130
            },
            {
                "text": "צה\"ל",
                "start_index": 1461,
                "end_index": 1465,
                "id": 131
            },
            {
                "text": "תוצאה מהקרב על מנזר",
                "start_index": 1472,
                "end_index": 1491,
                "id": 132
            },
            {
                "text": "הקרב על מנזר",
                "start_index": 1479,
