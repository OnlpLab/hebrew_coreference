                "id": 596
            },
            {
                "text": "הרעיון",
                "start_index": 6329,
                "end_index": 6335,
                "id": 597
            },
            {
                "text": "מענקים לחשיבה הימנית כשלעצמה",
                "start_index": 6353,
                "end_index": 6381,
                "id": 598
            },
