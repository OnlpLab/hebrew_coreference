                "text": "בוש",
                "start_index": 4006,
                "end_index": 4009,
                "id": 354
            },
            {
                "text": "המקרה החמישי",
                "start_index": 4015,
                "end_index": 4027,
                "id": 355
            },
            {
                "text": "לא מעט רפובליקאים הנוטים להסכים אתם",
