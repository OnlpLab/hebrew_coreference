                "end_index": 1405,
                "id": 133
            },
            {
                "text": "קבלת",
                "start_index": 1415,
                "end_index": 1419,
                "id": 134
            },
            {
                "text": "תפקיד חשוב באחד ממאות הגופים הללו",
                "start_index": 1420,
                "end_index": 1453,
                "id": 135
            },
            {
                "text": "אחד ממאות הגופים הללו",
