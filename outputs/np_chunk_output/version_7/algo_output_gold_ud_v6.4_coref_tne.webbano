                "id": 614
            },
            {
                "text": "ה",
                "start_index": 6931,
                "end_index": 6932,
                "id": 615
            },
            {
                "text": "מושל",
                "start_index": 6934,
                "end_index": 6938,
                "id": 616
            },
            {
                "text": "ה",
                "start_index": 6951,
                "end_index": 6952,
                "id": 617
            },
            {
                "text": "שני דמוקרטים אחרים, שהפיצו ידיעות כי היא השתמשה בעבר בסמים",
