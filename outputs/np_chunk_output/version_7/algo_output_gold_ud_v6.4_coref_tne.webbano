                "id": 317
            },
            {
                "text": "הארקין",
                "start_index": 3422,
                "end_index": 3428,
                "id": 318
            },
            {
                "text": "טוקי",
                "start_index": 3436,
                "end_index": 3440,
                "id": 319
            },
            {
                "text": "הפרש משכנע של 10%",
                "start_index": 3442,
                "end_index": 3459,
                "id": 320
            },
            {
                "text": "10%",
                "start_index": 3456,
                "end_index": 3459,
                "id": 321
            },
            {
                "text": "הוא",
                "start_index": 3461,
                "end_index": 3464,
                "id": 322
            },
            {
                "text": "הסנאטור הדמוקרטי הראשון בתולדות איובה הנבחר לתקופת כהונה שנייה",
                "start_index": 3465,
                "end_index": 3527,
                "id": 323
            },
            {
                "text": "תולדות",
                "start_index": 3490,
                "end_index": 3496,
