                "id": 156
            },
            {
                "text": "משרד",
                "start_index": 1511,
                "end_index": 1515,
                "id": 157
            },
            {
                "text": "העבודה והרווחה",
                "start_index": 1516,
                "end_index": 1530,
                "id": 158
            },
            {
                "text": "העבודה",
                "start_index": 1516,
                "end_index": 1522,
                "id": 159
            },
            {
                "text": "הרווחה",
                "start_index": 1524,
                "end_index": 1530,
                "id": 160
            },
            {
                "text": "דרישה לבטל בתוך חודש את עבודת העובדים הזרים המועסקים כיום תחת הכותרת \"מתנדבים\"",
                "start_index": 1532,
                "end_index": 1610,
                "id": 161
            },
            {
                "text": "חודש",
                "start_index": 1548,
                "end_index": 1552,
                "id": 162
            },
            {
                "text": "עבודת העובדים הזרים המועסקים כיום תחת הכותרת \"מתנדבים\"",
                "start_index": 1556,
                "end_index": 1610,
                "id": 163
            },
            {
                "text": "העובדים הזרים המועסקים כיום תחת הכותרת \"מתנדבים\"",
                "start_index": 1562,
                "end_index": 1610,
                "id": 164
            },
            {
