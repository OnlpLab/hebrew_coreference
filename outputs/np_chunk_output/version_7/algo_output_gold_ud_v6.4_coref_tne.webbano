                "id": 144
            },
            {
                "text": "סילבר",
                "start_index": 1645,
                "end_index": 1650,
                "id": 145
            },
            {
                "text": "העיתון \"בוסטון",
                "start_index": 1656,
                "end_index": 1670,
                "id": 146
            },
            {
                "text": "בוסטון",
                "start_index": 1664,
                "end_index": 1670,
                "id": 147
            },
            {
                "text": "גלוב",
                "start_index": 1671,
                "end_index": 1675,
                "id": 148
            },
            {
                "text": "סקר, שהראה לראשונה יתרון לסילבר על פני",
