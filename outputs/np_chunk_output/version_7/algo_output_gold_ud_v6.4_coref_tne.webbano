                "end_index": 1973,
                "id": 181
            },
            {
                "text": "רווחים",
                "start_index": 1996,
                "end_index": 2002,
                "id": 182
            },
            {
                "text": "רשתות אחרות כמוה",
                "start_index": 2005,
                "end_index": 2021,
                "id": 183
            },
            {
                "text": "ה",
                "start_index": 2020,
                "end_index": 2021,
                "id": 184
            },
            {
                "text": "שלטונות המקומיים",
                "start_index": 2043,
                "end_index": 2059,
                "id": 185
            },
            {
                "text": "הגבול בין \"שלא למטרות רווח\" ו",
                "start_index": 2061,
                "end_index": 2090,
                "id": 186
            },
            {
                "text": "מטרות רווח\" ו",
                "start_index": 2077,
                "end_index": 2090,
                "id": 187
            },
            {
                "text": "רווח",
                "start_index": 2083,
                "end_index": 2087,
                "id": 188
            },
            {
                "text": "מטרות",
                "start_index": 2096,
                "end_index": 2101,
                "id": 189
            },
            {
                "text": "רווח",
                "start_index": 2102,
                "end_index": 2106,
                "id": 190
            },
            {
                "text": "דרך",
                "start_index": 2123,
                "end_index": 2126,
                "id": 191
            },
            {
                "text": "כלל",
                "start_index": 2127,
                "end_index": 2130,
                "id": 192
            },
            {
                "text": "הכל",
                "start_index": 2131,
                "end_index": 2134,
                "id": 193
            },
            {
                "text": "הדוגמה הידועה ביותר לשמצה מהתקופה האחרונה",
                "start_index": 2149,
                "end_index": 2190,
                "id": 194
            },
            {
                "text": "שמצה",
                "start_index": 2170,
                "end_index": 2174,
                "id": 195
            },
            {
                "text": "התקופה האחרונה",
                "start_index": 2176,
                "end_index": 2190,
                "id": 196
            },
            {
                "text": "היא",
                "start_index": 2191,
                "end_index": 2194,
                "id": 197
            },
            {
                "text": "השימוש בכספי קרן גאנט לרכישת",
                "start_index": 2195,
                "end_index": 2223,
                "id": 198
            },
            {
                "text": "כספי",
                "start_index": 2203,
                "end_index": 2207,
                "id": 199
            },
            {
                "text": "קרן",
                "start_index": 2208,
                "end_index": 2211,
                "id": 200
            },
            {
                "text": "גאנט",
                "start_index": 2212,
                "end_index": 2216,
                "id": 201
            },
            {
                "text": "רכישת",
                "start_index": 2218,
                "end_index": 2223,
                "id": 202
            },
            {
                "text": "אלפי עותקים של האוטוביוגרפיה של יו\"ר גאנט לשעבר, אלאן",
                "start_index": 2224,
                "end_index": 2277,
                "id": 203
            },
            {
                "text": "האוטוביוגרפיה של יו\"ר גאנט לשעבר, אלאן",
                "start_index": 2239,
                "end_index": 2277,
                "id": 204
            },
            {
                "text": "יו\"ר גאנט לשעבר, אלאן",
                "start_index": 2256,
                "end_index": 2277,
                "id": 205
            },
            {
                "text": "גאנט",
                "start_index": 2261,
                "end_index": 2265,
                "id": 206
            },
            {
                "text": "אלאן",
                "start_index": 2273,
                "end_index": 2277,
                "id": 207
            },
            {
                "text": "נויהארט",
                "start_index": 2278,
                "end_index": 2285,
                "id": 208
            },
            {
                "text": "הדבר",
                "start_index": 2287,
                "end_index": 2291,
                "id": 209
            },
            {
                "text": "הספר",
                "start_index": 2307,
                "end_index": 2311,
                "id": 210
            },
            {
                "text": "רשימת רבי-המכר של \"ניו יורק טיימס\", מעמד שבדרך כלל גורר בעקבותיו מכירת",
                "start_index": 2313,
                "end_index": 2383,
                "id": 211
            },
            {
                "text": "רבי",
                "start_index": 2319,
                "end_index": 2322,
                "id": 212
            },
            {
                "text": "המכר",
                "start_index": 2323,
                "end_index": 2327,
                "id": 213
            },
            {
                "text": "ניו",
                "start_index": 2332,
                "end_index": 2335,
                "id": 214
            },
            {
                "text": "יורק",
                "start_index": 2336,
                "end_index": 2340,
                "id": 215
            },
            {
                "text": "טיימס",
                "start_index": 2341,
                "end_index": 2346,
                "id": 216
            },
            {
                "text": "מעמד שבדרך כלל גורר בעקבותיו מכירת",
                "start_index": 2349,
                "end_index": 2383,
