                "text": "הוא",
                "start_index": 1544,
                "end_index": 1547,
                "id": 136
            },
            {
                "text": "הבוס, המתכוון לעשות טיהור פוליטי במשרד",
                "start_index": 1548,
                "end_index": 1586,
                "id": 137
            },
            {
                "text": "טיהור פוליטי",
