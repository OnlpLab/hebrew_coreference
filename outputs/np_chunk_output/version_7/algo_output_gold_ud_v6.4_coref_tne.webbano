            },
            {
                "text": "עצה מספר 8",
                "start_index": 8798,
                "end_index": 8808,
                "id": 820
            },
            {
                "text": "מספר 8",
                "start_index": 8802,
                "end_index": 8808,
                "id": 821
            },
            {
                "text": "שבשבת רוח של רוח",
                "start_index": 8815,
                "end_index": 8831,
                "id": 822
            },
            {
                "text": "רוח",
                "start_index": 8821,
                "end_index": 8824,
                "id": 823
            },
            {
                "text": "רוח",
                "start_index": 8828,
                "end_index": 8831,
                "id": 824
            },
            {
                "text": "התקופה",
                "start_index": 8832,
                "end_index": 8838,
                "id": 825
            },
            {
                "text": "כל דבר אחר",
                "start_index": 8844,
                "end_index": 8854,
                "id": 826
            },
            {
                "text": "נושאים הזוכים לסבסוד נכבד",
                "start_index": 8856,
                "end_index": 8881,
                "id": 827
            },
            {
                "text": "סבסוד נכבד",
                "start_index": 8871,
                "end_index": 8881,
                "id": 828
            },
            {
                "text": "סוף",
                "start_index": 8897,
                "end_index": 8900,
                "id": 829
            },
            {
                "text": "שנות",
                "start_index": 8901,
                "end_index": 8905,
                "id": 830
            },
            {
                "text": "תחום",
                "start_index": 8926,
                "end_index": 8930,
                "id": 831
            },
            {
                "text": "היחסים הבין-לאומיים",
