            },
            {
                "text": "עצה מספר 9",
                "start_index": 9379,
                "end_index": 9389,
                "id": 873
            },
            {
                "text": "מספר 9",
                "start_index": 9383,
                "end_index": 9389,
                "id": 874
            },
            {
                "text": "רשותך",
                "start_index": 9403,
                "end_index": 9408,
                "id": 875
            },
            {
                "text": "טרמינולוגיה קיימת",
                "start_index": 9409,
                "end_index": 9426,
                "id": 876
            },
            {
                "text": "יעד",
                "start_index": 9434,
                "end_index": 9437,
                "id": 877
            },
            {
                "text": "המשחק",
                "start_index": 9438,
                "end_index": 9443,
                "id": 878
            },
            {
                "text": "הוא",
                "start_index": 9444,
                "end_index": 9447,
                "id": 879
            },
            {
                "text": "ביטחון לאומי",
                "start_index": 9455,
                "end_index": 9467,
                "id": 880
            },
            {
                "text": "נושא רב-שנתי עמיד",
                "start_index": 9470,
                "end_index": 9487,
                "id": 881
            },
            {
                "text": "ו",
                "start_index": 9499,
                "end_index": 9500,
                "id": 882
            },
            {
                "text": "תחום המומחיות שלך",
                "start_index": 9502,
                "end_index": 9519,
                "id": 883
            },
            {
                "text": "המומחיות",
                "start_index": 9507,
                "end_index": 9515,
                "id": 884
            },
            {
                "text": "ך",
                "start_index": 9518,
                "end_index": 9519,
                "id": 885
            },
            {
                "text": "בעלי",
                "start_index": 9521,
                "end_index": 9525,
                "id": 886
            },
            {
                "text": "המודעות הסביבתית הכלל-עולמית",
                "start_index": 9526,
                "end_index": 9554,
                "id": 887
            },
            {
                "text": "ביטחון לאומי",
                "start_index": 9592,
                "end_index": 9604,
                "id": 888
            },
            {
                "text": "ביטחון",
                "start_index": 9611,
                "end_index": 9617,
                "id": 889
            },
            {
                "text": "כדור",
                "start_index": 9618,
                "end_index": 9622,
                "id": 890
            },
            {
                "text": "הארץ",
                "start_index": 9623,
                "end_index": 9627,
                "id": 891
            },
            {
                "text": "הטיפוסים לובשי החליפות הכהות, השייכים לזרם מרכזי יותר",
                "start_index": 9630,
                "end_index": 9683,
                "id": 892
            },
            {
                "text": "החליפות הכהות",
                "start_index": 9645,
                "end_index": 9658,
                "id": 893
            },
            {
                "text": "זרם מרכזי יותר",
                "start_index": 9669,
                "end_index": 9683,
                "id": 894
            },
            {
                "text": "שום מדינה",
                "start_index": 9693,
                "end_index": 9702,
                "id": 895
            },
            {
                "text": "מבנה ביטחון אירופי יציב",
                "start_index": 9738,
                "end_index": 9761,
                "id": 896
            },
            {
                "text": "ביטחון",
                "start_index": 9743,
                "end_index": 9749,
                "id": 897
            },
            {
                "text": "כלכלנים בחבורת מקדמי המדיניות התעשייתית, יחד עם מחנכים בחבורת",
                "start_index": 9765,
                "end_index": 9826,
                "id": 898
            },
            {
                "text": "חבורת",
                "start_index": 9774,
                "end_index": 9779,
                "id": 899
            },
            {
                "text": "מקדמי",
                "start_index": 9780,
                "end_index": 9785,
                "id": 900
            },
            {
                "text": "המדיניות התעשייתית",
                "start_index": 9786,
                "end_index": 9804,
                "id": 901
            },
            {
                "text": "מחנכים בחבורת",
                "start_index": 9813,
                "end_index": 9826,
                "id": 902
            },
            {
                "text": "חבורת",
                "start_index": 9821,
                "end_index": 9826,
                "id": 903
            },
            {
                "text": "החינוך למצוינות",
                "start_index": 9827,
                "end_index": 9842,
                "id": 904
            },
            {
                "text": "מצוינות",
                "start_index": 9835,
                "end_index": 9842,
                "id": 905
            },
            {
                "text": "עורמה",
                "start_index": 9850,
                "end_index": 9855,
                "id": 906
            },
            {
                "text": "ידם",
                "start_index": 9861,
                "end_index": 9864,
                "id": 907
            },
            {
                "text": "ם",
                "start_index": 9863,
                "end_index": 9864,
                "id": 908
            },
            {
                "text": "כספי",
                "start_index": 9868,
                "end_index": 9872,
                "id": 909
            },
            {
                "text": "מדיניות",
                "start_index": 9873,
                "end_index": 9880,
                "id": 910
            },
            {
                "text": "החוץ",
                "start_index": 9881,
                "end_index": 9885,
                "id": 911
            },
            {
                "text": "טענה שבעתיד יוגדר הביטחון הלאומי במונחים של כושר תחרות כלכלי, לא של עוצמה צבאית",
                "start_index": 9888,
                "end_index": 9967,
                "id": 912
            },
            {
                "text": "עתיד",
                "start_index": 9895,
                "end_index": 9899,
                "id": 913
            },
            {
                "text": "הביטחון הלאומי",
                "start_index": 9906,
                "end_index": 9920,
                "id": 914
            },
            {
                "text": "מונחים של כושר תחרות כלכלי, לא של עוצמה צבאית",
                "start_index": 9922,
                "end_index": 9967,
                "id": 915
            },
            {
                "text": "כושר תחרות כלכלי, לא של עוצמה צבאית",
                "start_index": 9932,
                "end_index": 9967,
                "id": 916
            },
            {
                "text": "כושר תחרות כלכלי",
                "start_index": 9932,
                "end_index": 9948,
                "id": 917
            },
            {
                "text": "תחרות",
                "start_index": 9937,
                "end_index": 9942,
                "id": 918
            },
            {
                "text": "עוצמה צבאית",
                "start_index": 9956,
                "end_index": 9967,
                "id": 919
            },
            {
                "text": "אנשים אלה",
                "start_index": 9974,
                "end_index": 9983,
                "id": 920
            },
            {
                "text": "סדאם",
                "start_index": 9984,
                "end_index": 9988,
                "id": 921
            },
            {
                "text": "חוסיין",
                "start_index": 9989,
                "end_index": 9995,
                "id": 922
            },
            {
                "text": "הוא",
                "start_index": 9996,
                "end_index": 9999,
                "id": 923
            },
            {
                "text": "מטרד",
                "start_index": 10000,
                "end_index": 10004,
                "id": 924
            },
            {
                "text": "סדאם",
                "start_index": 10010,
                "end_index": 10014,
                "id": 925
            },
            {
                "text": "חוסיין",
                "start_index": 10015,
                "end_index": 10021,
                "id": 926
            },
            {
                "text": "מתת",
                "start_index": 10026,
                "end_index": 10029,
                "id": 927
            },
            {
                "text": "שמים לכל המומחים לפיקוח רב-צדדי על הנשק, הטוענים",
                "start_index": 10030,
                "end_index": 10078,
                "id": 928
            },
            {
                "text": "כל המומחים לפיקוח רב-צדדי על הנשק, הטוענים",
                "start_index": 10036,
                "end_index": 10078,
                "id": 929
            },
            {
                "text": "פיקוח רב-צדדי על הנשק",
                "start_index": 10048,
                "end_index": 10069,
                "id": 930
            },
            {
                "text": "הנשק",
                "start_index": 10065,
                "end_index": 10069,
                "id": 931
            },
            {
                "text": "זה שנים",
                "start_index": 10079,
                "end_index": 10086,
                "id": 932
            },
            {
                "text": "הזרמתו של נשק מתוחכם לדיקטטורים רברבנים בעולם השלישי",
                "start_index": 10101,
                "end_index": 10153,
                "id": 933
            },
            {
                "text": "ו",
                "start_index": 10106,
                "end_index": 10107,
                "id": 934
            },
            {
                "text": "נשק מתוחכם",
                "start_index": 10111,
                "end_index": 10121,
                "id": 935
            },
            {
                "text": "דיקטטורים רברבנים בעולם השלישי",
                "start_index": 10123,
                "end_index": 10153,
                "id": 936
            },
            {
                "text": "עולם השלישי",
                "start_index": 10142,
                "end_index": 10153,
                "id": 937
            },
            {
                "text": "קומץ אנשים שניסו למשוך אליהם כספי מענקים בעת שהעולם המטיר דולרים עלאסטרטגיה גרעינית ופיקוח רב-צדדי על הנשק",
                "start_index": 10162,
                "end_index": 10268,
                "id": 938
            },
            {
                "text": "אנשים",
                "start_index": 10167,
                "end_index": 10172,
                "id": 939
            },
            {
                "text": "הם",
                "start_index": 10188,
                "end_index": 10190,
                "id": 940
            },
            {
                "text": "כספי",
                "start_index": 10191,
                "end_index": 10195,
                "id": 941
            },
            {
                "text": "מענקים",
                "start_index": 10196,
                "end_index": 10202,
                "id": 942
            },
            {
                "text": "עת שהעולם המטיר דולרים עלאסטרטגיה גרעינית ופיקוח רב-צדדי על הנשק",
                "start_index": 10204,
                "end_index": 10268,
                "id": 943
            },
            {
                "text": "העולם",
                "start_index": 10208,
                "end_index": 10213,
                "id": 944
            },
            {
                "text": "דולרים",
                "start_index": 10220,
                "end_index": 10226,
                "id": 945
            },
            {
                "text": "אסטרטגיה גרעינית ופיקוח רב-צדדי על הנשק",
                "start_index": 10229,
                "end_index": 10268,
                "id": 946
            },
            {
                "text": "אסטרטגיה גרעינית",
                "start_index": 10229,
                "end_index": 10245,
                "id": 947
            },
            {
                "text": "פיקוח רב-צדדי על הנשק",
                "start_index": 10247,
                "end_index": 10268,
                "id": 948
            },
            {
                "text": "הנשק",
                "start_index": 10264,
                "end_index": 10268,
                "id": 949
            },
            {
                "text": "עובדה זו",
                "start_index": 10270,
                "end_index": 10278,
                "id": 950
            },
            {
                "text": "יסוד לתלונה שכיחה בתחום",
                "start_index": 10285,
                "end_index": 10308,
                "id": 951
            },
            {
                "text": "תלונה שכיחה בתחום",
                "start_index": 10291,
                "end_index": 10308,
                "id": 952
            },
            {
                "text": "תחום",
                "start_index": 10304,
                "end_index": 10308,
                "id": 953
            },
            {
                "text": "הפילנטרופיה",
                "start_index": 10309,
                "end_index": 10320,
                "id": 954
            },
            {
                "text": "התמקדותם של קרנות וצוותות חשיבה במגמות אופנתיות",
                "start_index": 10322,
                "end_index": 10369,
                "id": 955
            },
            {
                "text": "ם",
                "start_index": 10329,
                "end_index": 10330,
                "id": 956
            },
            {
                "text": "קרנות וצוותות",
                "start_index": 10334,
                "end_index": 10347,
                "id": 957
            },
            {
                "text": "קרנות",
                "start_index": 10334,
                "end_index": 10339,
                "id": 958
            },
            {
                "text": "צוותות",
                "start_index": 10341,
                "end_index": 10347,
                "id": 959
            },
            {
                "text": "חשיבה",
                "start_index": 10348,
                "end_index": 10353,
                "id": 960
            },
            {
                "text": "מגמות אופנתיות",
                "start_index": 10355,
                "end_index": 10369,
                "id": 961
            },
            {
                "text": "כך שהחברה בקושי ערוכה לגלים היסטוריים חדשים",
                "start_index": 10377,
                "end_index": 10420,
                "id": 962
            },
            {
                "text": "כך",
                "start_index": 10377,
                "end_index": 10379,
                "id": 963
            },
            {
                "text": "החברה",
                "start_index": 10381,
                "end_index": 10386,
                "id": 964
            },
            {
                "text": "גלים היסטוריים חדשים",
                "start_index": 10400,
                "end_index": 10420,
                "id": 965
            },
            {
                "text": "גיימס אלן סמית, מחבר",
                "start_index": 10422,
                "end_index": 10442,
                "id": 966
            },
            {
                "text": "אלן",
                "start_index": 10428,
                "end_index": 10431,
                "id": 967
            },
            {
                "text": "סמית",
                "start_index": 10432,
                "end_index": 10436,
                "id": 968
            },
            {
                "text": "מחבר",
                "start_index": 10438,
                "end_index": 10442,
                "id": 969
            },
            {
                "text": "הספר \"הברוקרים של הרעיונות: צוותות חשיבה ועלייתה של עלית מדיניות חדשה\"",
                "start_index": 10443,
                "end_index": 10513,
                "id": 970
            },
            {
                "text": "הברוקרים של הרעיונות: צוותות חשיבה ועלייתה של עלית מדיניות חדשה",
                "start_index": 10449,
                "end_index": 10512,
                "id": 971
            },
            {
                "text": "הרעיונות",
                "start_index": 10461,
                "end_index": 10469,
                "id": 972
            },
            {
                "text": "צוותות חשיבה ועלייתה של עלית מדיניות חדשה",
                "start_index": 10471,
                "end_index": 10512,
                "id": 973
            },
            {
                "text": "צוותות",
                "start_index": 10471,
                "end_index": 10477,
                "id": 974
            },
            {
                "text": "חשיבה",
                "start_index": 10478,
                "end_index": 10483,
                "id": 975
            },
            {
                "text": "עלייתה של עלית מדיניות חדשה",
                "start_index": 10485,
                "end_index": 10512,
                "id": 976
            },
            {
                "text": "ה",
                "start_index": 10490,
                "end_index": 10491,
                "id": 977
            },
            {
                "text": "עלית מדיניות חדשה",
                "start_index": 10495,
                "end_index": 10512,
                "id": 978
            },
            {
                "text": "מדיניות",
                "start_index": 10500,
                "end_index": 10507,
                "id": 979
            },
            {
                "text": "ההתמקדות בבעיות מדיניות דוחקות, ודעיכת",
                "start_index": 10523,
                "end_index": 10561,
                "id": 980
            },
            {
                "text": "ההתמקדות",
                "start_index": 10523,
                "end_index": 10531,
                "id": 981
            },
            {
                "text": "בעיות מדיניות דוחקות",
                "start_index": 10533,
                "end_index": 10553,
                "id": 982
            },
            {
                "text": "מדיניות",
                "start_index": 10539,
                "end_index": 10546,
                "id": 983
            },
            {
                "text": "דעיכת",
                "start_index": 10556,
                "end_index": 10561,
                "id": 984
            },
            {
                "text": "האמונה בערכו של מחקר בסיסי במדעי",
                "start_index": 10562,
                "end_index": 10594,
                "id": 985
            },
            {
                "text": "ערכו של מחקר בסיסי במדעי",
                "start_index": 10570,
                "end_index": 10594,
                "id": 986
            },
            {
                "text": "ו",
                "start_index": 10573,
                "end_index": 10574,
                "id": 987
            },
            {
                "text": "מחקר בסיסי במדעי",
                "start_index": 10578,
                "end_index": 10594,
                "id": 988
            },
            {
                "text": "מדעי",
                "start_index": 10590,
                "end_index": 10594,
                "id": 989
            },
            {
                "text": "החברה",
                "start_index": 10595,
                "end_index": 10600,
                "id": 990
            },
            {
                "text": "נו",
                "start_index": 10612,
                "end_index": 10614,
                "id": 991
            },
            {
                "text": "מאגר נרחב של מומחים",
                "start_index": 10619,
                "end_index": 10638,
                "id": 992
            },
            {
                "text": "מומחים",
                "start_index": 10632,
                "end_index": 10638,
                "id": 993
            },
            {
                "text": "ו",
                "start_index": 10644,
                "end_index": 10645,
                "id": 994
            },
            {
                "text": "הצורך",
                "start_index": 10669,
                "end_index": 10674,
                "id": 995
            },
            {
                "text": "זה",
                "start_index": 10676,
                "end_index": 10678,
                "id": 996
            },
            {
                "text": "הכל",
                "start_index": 10690,
                "end_index": 10693,
                "id": 997
            },
            {
                "text": "כמה מחקרים בחסות",
                "start_index": 10695,
                "end_index": 10711,
                "id": 998
            },
            {
                "text": "חסות",
                "start_index": 10707,
                "end_index": 10711,
                "id": 999
            },
            {
                "text": "קרנות",
                "start_index": 10712,
                "end_index": 10717,
                "id": 1000
            },
            {
                "text": "תקופת",
                "start_index": 10726,
                "end_index": 10731,
                "id": 1001
            },
            {
                "text": "האובססיה הממושכת למלחמה הקרה",
                "start_index": 10732,
                "end_index": 10760,
                "id": 1002
            },
            {
                "text": "מלחמה הקרה",
                "start_index": 10750,
                "end_index": 10760,
                "id": 1003
            },
            {
                "text": "ניסיון לגלות באיזו מידה אדם כמו סדאם חוסיין עלול להיות מסוכן",
                "start_index": 10762,
                "end_index": 10822,
                "id": 1004
            },
            {
                "text": "איזו מידה",
                "start_index": 10776,
                "end_index": 10785,
                "id": 1005
            },
            {
                "text": "אדם כמו סדאם חוסיין",
                "start_index": 10786,
                "end_index": 10805,
                "id": 1006
            },
            {
                "text": "סדאם חוסיין",
                "start_index": 10794,
                "end_index": 10805,
                "id": 1007
            },
            {
                "text": "חוסיין",
                "start_index": 10799,
                "end_index": 10805,
                "id": 1008
            },
            {
                "text": "כמה מחקרים",
                "start_index": 10824,
                "end_index": 10834,
                "id": 1009
            },
            {
                "text": "כלכלה סטליניסטית",
                "start_index": 10851,
                "end_index": 10867,
                "id": 1010
            },
            {
                "text": "כלכלת",
                "start_index": 10869,
                "end_index": 10874,
                "id": 1011
            },
            {
                "text": "שוק חופשי",
                "start_index": 10875,
                "end_index": 10884,
                "id": 1012
            },
            {
                "text": "סימוכין לדעה שכיום אלו הן שתי הבעיות הדוחקות ביותר של העולם",
                "start_index": 10889,
                "end_index": 10948,
                "id": 1013
            },
            {
                "text": "דעה שכיום אלו הן שתי הבעיות הדוחקות ביותר של העולם",
                "start_index": 10898,
                "end_index": 10948,
                "id": 1014
            },
            {
                "text": "אלו",
                "start_index": 10908,
                "end_index": 10911,
                "id": 1015
            },
            {
                "text": "הן",
                "start_index": 10912,
                "end_index": 10914,
                "id": 1016
            },
            {
                "text": "שתי הבעיות הדוחקות ביותר של העולם",
                "start_index": 10915,
                "end_index": 10948,
                "id": 1017
            },
            {
                "text": "הדוחקות",
                "start_index": 10926,
                "end_index": 10933,
                "id": 1018
            },
            {
                "text": "העולם",
                "start_index": 10943,
                "end_index": 10948,
                "id": 1019
            },
            {
                "text": "ביטחון",
                "start_index": 10964,
                "end_index": 10970,
                "id": 1020
            },
            {
                "text": "דולר אחד",
                "start_index": 10979,
                "end_index": 10987,
                "id": 1021
            },
            {
                "text": "למעלה מ",
                "start_index": 10993,
                "end_index": 11000,
                "id": 1022
            },
            {
                "text": "50 מיליארד הדולרים שהוציאו",
                "start_index": 11000,
                "end_index": 11026,
                "id": 1023
            },
            {
                "text": "קרנות",
                "start_index": 11027,
                "end_index": 11032,
                "id": 1024
            },
            {
                "text": "1979",
                "start_index": 11037,
                "end_index": 11041,
                "id": 1025
            },
            {
                "text": "הבהרתן",
                "start_index": 11058,
                "end_index": 11064,
                "id": 1026
            },
            {
                "text": "ן",
                "start_index": 11063,
                "end_index": 11064,
                "id": 1027
            },
            {
                "text": "הכסף",
                "start_index": 11070,
                "end_index": 11074,
                "id": 1028
            },
            {
                "text": "הרעיונות",
                "start_index": 11083,
                "end_index": 11091,
                "id": 1029
            },
            {
                "text": "הרעיונות",
                "start_index": 11105,
                "end_index": 11113,
                "id": 1030
            },
            {
                "text": "תמיכה כספית בזכות ערכם והחידוש שבהם",
                "start_index": 11115,
                "end_index": 11150,
                "id": 1031
            },
            {
                "text": "ערכם והחידוש שבהם",
                "start_index": 11133,
                "end_index": 11150,
                "id": 1032
            },
            {
                "text": "ערכם",
                "start_index": 11133,
                "end_index": 11137,
                "id": 1033
            },
            {
                "text": "ם",
                "start_index": 11136,
                "end_index": 11137,
                "id": 1034
            },
            {
                "text": "החידוש שבהם",
                "start_index": 11139,
                "end_index": 11150,
                "id": 1035
            },
            {
                "text": "הם",
                "start_index": 11148,
                "end_index": 11150,
                "id": 1036
            },
            {
                "text": "שאלות אלו",
                "start_index": 11165,
                "end_index": 11174,
                "id": 1037
            },
            {
                "text": "ך",
                "start_index": 11178,
                "end_index": 11179,
                "id": 1038
            },
            {
                "text": "אלו",
                "start_index": 11200,
                "end_index": 11203,
                "id": 1039
            },
            {
                "text": "הרהורים קוסמיים על טבעה של ההיסטוריה",
                "start_index": 11204,
                "end_index": 11240,
                "id": 1040
            },
            {
                "text": "טבעה של ההיסטוריה",
                "start_index": 11223,
                "end_index": 11240,
                "id": 1041
            },
            {
                "text": "ה",
                "start_index": 11226,
                "end_index": 11227,
                "id": 1042
            },
            {
                "text": "ההיסטוריה",
                "start_index": 11231,
                "end_index": 11240,
                "id": 1043
            },
            {
                "text": "מחשבה",
                "start_index": 11250,
                "end_index": 11255,
                "id": 1044
            },
            {
                "text": "דיאלקטיקה הגליאנית, לתיאוריות על מקומו של האדם הגדול בהיסטוריה וכך הלאה",
                "start_index": 11257,
                "end_index": 11328,
                "id": 1045
            },
            {
                "text": "תיאוריות על מקומו של האדם הגדול בהיסטוריה",
                "start_index": 11278,
                "end_index": 11319,
                "id": 1046
            },
            {
                "text": "מקומו של האדם הגדול בהיסטוריה",
                "start_index": 11290,
                "end_index": 11319,
                "id": 1047
            },
            {
                "text": "ו",
                "start_index": 11294,
                "end_index": 11295,
                "id": 1048
            },
            {
                "text": "האדם הגדול",
                "start_index": 11299,
                "end_index": 11309,
                "id": 1049
            },
            {
                "text": "היסטוריה",
                "start_index": 11311,
                "end_index": 11319,
                "id": 1050
            },
            {
                "text": "זה",
                "start_index": 11331,
                "end_index": 11333,
                "id": 1051
            },
            {
                "text": "מבצע מהסוג",
                "start_index": 11339,
                "end_index": 11349,
                "id": 1052
            },
            {
                "text": "הסוג",
                "start_index": 11345,
                "end_index": 11349,
                "id": 1053
            },
            {
                "text": "ו",
                "start_index": 11362,
                "end_index": 11363,
                "id": 1054
            },
            {
                "text": "מימון נכבד",
                "start_index": 11368,
                "end_index": 11378,
                "id": 1055
            }
        ],
