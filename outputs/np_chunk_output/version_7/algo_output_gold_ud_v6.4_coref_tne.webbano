                "end_index": 4956,
                "id": 446
            },
            {
                "text": "נאום מלהיב",
                "start_index": 4961,
                "end_index": 4971,
                "id": 447
            },
            {
                "text": "ועידת",
                "start_index": 4979,
                "end_index": 4984,
                "id": 448
            },
            {
                "text": "המפלגה הדמוקרטית",
                "start_index": 4985,
                "end_index": 5001,
                "id": 449
            },
            {
                "text": "קיץ",
                "start_index": 5004,
                "end_index": 5007,
                "id": 450
            },
            {
                "text": "העובדה שנחל ניצחון כל כך לא מרשים על יריבים כל כך לא מרשימים",
                "start_index": 5014,
                "end_index": 5074,
                "id": 451
            },
            {
                "text": "ניצחון כל כך לא מרשים על יריבים כל כך לא מרשימים",
                "start_index": 5026,
                "end_index": 5074,
                "id": 452
            },
            {
                "text": "יריבים כל כך לא מרשימים",
                "start_index": 5051,
                "end_index": 5074,
                "id": 453
            },
