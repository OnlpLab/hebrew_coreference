      "id": 0
    },
    {
      "text": "הבנקים",
      "start_index": 18,
      "end_index": 24,
      "id": 1
    },
    {
      "text": "ימים אלה",
      "start_index": 31,
      "end_index": 39,
      "id": 2
    },
    {
      "text": "ניהול_של__הם של תיקי השקעות במטבע חוץ בה_מערכת הבנקאית",
      "start_index": 45,
      "end_index": 99,
      "id": 3
    },
    {
      "text": "_הם",
      "start_index": 54,
      "end_index": 57,
      "id": 4
    },
    {
      "text": "תיקי השקעות במטבע חוץ",
