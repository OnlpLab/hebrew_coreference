      "id": 7
    },
    {
      "text": "ה_מערכת הבנקאית",
      "start_index": 84,
      "end_index": 99,
      "id": 8
    },
    {
      "text": "הבדיקה",
      "start_index": 101,
      "end_index": 107,
      "id": 9
    },
    {
      "text": "תוצאה משתי פרשות ההסתבכות האחרונות בבנק איגוד, הנוגעות לניהול תיקי ההשקעות של הלקוחות",
      "start_index": 116,
      "end_index": 202,
      "id": 10
    },
    {
      "text": "שתי פרשות ההסתבכות האחרונות בבנק איגוד, הנוגעות לניהול תיקי ההשקעות של הלקוחות",
      "start_index": 123,
      "end_index": 201,
      "id": 11
    },
    {
      "text": "בנק איגוד",
      "start_index": 152,
      "end_index": 161,
      "id": 12
    },
    {
      "text": "ניהול תיקי ההשקעות של הלקוחות",
      "start_index": 172,
      "end_index": 201,
      "id": 13
    },
    {
      "text": "תיקי ההשקעות של הלקוחות",
      "start_index": 178,
