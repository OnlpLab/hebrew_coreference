                "end_token": 3,
                "sent_num": 31,
                "id": 277
            },
            {
                "text": "_הוא",
                "start_index": 3664,
                "end_index": 3668,
                "start_token": 7,
                "end_token": 8,
                "sent_num": 31,
                "id": 278
            },
            {
                "text": "סדרי עדיפויות משל_הוא גם בה_ספורט",
                "start_index": 3647,
                "end_index": 3680,
                "start_token": 3,
                "end_token": 12,
                "sent_num": 31,
                "id": 279
            },
            {
                "text": "ה_ספורט",
                "start_index": 3673,
                "end_index": 3680,
                "start_token": 10,
                "end_token": 12,
                "sent_num": 31,
                "id": 280
            },
            {
                "text": "טניס",
                "start_index": 3694,
                "end_index": 3698,
                "start_token": 15,
                "end_token": 16,
                "sent_num": 31,
                "id": 281
            },
            {
                "text": "טניס וכדורסל",
                "start_index": 3694,
                "end_index": 3706,
                "start_token": 15,
                "end_token": 18,
                "sent_num": 31,
                "id": 282
            },
            {
                "text": "כדורסל",
                "start_index": 3700,
                "end_index": 3706,
                "start_token": 17,
                "end_token": 18,
                "sent_num": 31,
                "id": 283
            },
            {
                "text": "הוא",
                "start_index": 3708,
                "end_index": 3711,
                "start_token": 19,
                "end_token": 20,
                "sent_num": 31,
                "id": 284
            },
            {
                "text": "צורת בילוי אחרת",
                "start_index": 3718,
                "end_index": 3733,
                "start_token": 21,
                "end_token": 24,
                "sent_num": 31,
                "id": 285
            },
            {
                "text": "קנקן בירה",
                "start_index": 3735,
                "end_index": 3744,
                "start_token": 25,
                "end_token": 27,
                "sent_num": 31,
                "id": 286
            },
            {
                "text": "פאב",
                "start_index": 3746,
                "end_index": 3749,
                "start_token": 28,
                "end_token": 29,
                "sent_num": 31,
                "id": 287
            },
            {
                "text": "דיסקוטקים",
                "start_index": 3751,
                "end_index": 3760,
                "start_token": 30,
                "end_token": 31,
                "sent_num": 31,
                "id": 288
            },
            {
                "text": "טוטו",
                "start_index": 3769,
                "end_index": 3773,
                "start_token": 33,
                "end_token": 34,
                "sent_num": 31,
                "id": 289
            },
            {
                "text": "צורת בילוי אחרת: קנקן בירה בפאב, דיסקוטקים, הימורי טוטו ולוטו",
                "start_index": 3718,
                "end_index": 3779,
                "start_token": 21,
                "end_token": 36,
                "sent_num": 31,
                "id": 290
            },
            {
                "text": "קנקן בירה בפאב, דיסקוטקים, הימורי טוטו ולוטו",
                "start_index": 3735,
                "end_index": 3779,
                "start_token": 25,
                "end_token": 36,
                "sent_num": 31,
                "id": 291
            },
            {
                "text": "הימורי טוטו ולוטו",
                "start_index": 3762,
                "end_index": 3779,
                "start_token": 32,
                "end_token": 36,
                "sent_num": 31,
                "id": 292
            },
            {
