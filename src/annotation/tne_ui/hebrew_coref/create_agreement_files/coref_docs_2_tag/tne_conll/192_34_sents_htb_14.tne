                "sent_num": 22,
                "id": 187
            },
            {
                "text": "עו\"ד איב זפה",
                "start_index": 2036,
                "end_index": 2048,
                "start_token": 22,
                "end_token": 25,
                "sent_num": 22,
                "id": 188
            },
            {
                "text": "בירור",
                "start_index": 2084,
                "end_index": 2089,
                "start_token": 35,
                "end_token": 36,
                "sent_num": 22,
                "id": 189
            },
            {
                "text": "פאפון",
                "start_index": 2116,
                "end_index": 2121,
                "start_token": 43,
                "end_token": 44,
                "sent_num": 22,
                "id": 190
            },
            {
                "text": "חוסר הרצון הפוליטי להביא לידי בירור את שלוש הפרשיות של בוסקה, פאפון וטובייה",
                "start_index": 2054,
                "end_index": 2129,
                "start_token": 28,
                "end_token": 46,
                "sent_num": 22,
                "id": 191
            },
            {
                "text": "שלוש הפרשיות של בוסקה, פאפון וטובייה",
                "start_index": 2093,
                "end_index": 2129,
                "start_token": 37,
                "end_token": 46,
                "sent_num": 22,
                "id": 192
            },
            {
                "text": "בוסקה, פאפון וטובייה",
                "start_index": 2109,
                "end_index": 2129,
                "start_token": 41,
                "end_token": 46,
                "sent_num": 22,
                "id": 193
            },
            {
