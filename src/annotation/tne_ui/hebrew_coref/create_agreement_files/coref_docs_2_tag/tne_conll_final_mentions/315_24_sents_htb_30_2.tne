                "start_token": 8,
                "end_token": 9,
                "sent_num": 20,
                "id": 197
            },
            {
                "text": "אנשים כמו יואל לרנר, אלי אדיר ויוסי דיין, שיצגו שכבה חברתית שונה מזו שעם_היא נמנים רוב אנשי \"כך\"",
                "start_index": 2210,
                "end_index": 2306,
                "start_token": 9,
                "end_token": 36,
                "sent_num": 20,
                "id": 198
            },
            {
