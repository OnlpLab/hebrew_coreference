                "start_index": 2248,
                "end_index": 2252,
                "start_token": 40,
                "end_token": 41,
                "sent_num": 18,
                "id": 185
            },
            {
                "text": "כאן",
                "start_index": 2263,
                "end_index": 2266,
                "start_token": 2,
                "end_token": 3,
                "sent_num": 19,
                "id": 186
            },
            {
                "text": "וייט",
                "start_index": 2267,
                "end_index": 2271,
                "start_token": 3,
                "end_token": 4,
                "sent_num": 19,
                "id": 187
            },
            {
                "text": "_הוא",
                "start_index": 2288,
                "end_index": 2292,
                "start_token": 8,
                "end_token": 9,
                "sent_num": 19,
                "id": 188
            },
            {
                "text": "אותו זמן",
                "start_index": 2294,
                "end_index": 2302,
                "start_token": 10,
                "end_token": 12,
                "sent_num": 19,
                "id": 189
            },
            {
                "text": "מתחת לקליפה_של__הוא של רומאן היסטורי, כביכול, אודיסיאה מודרנית, או אלתורים על מחזה פאסיון",
                "start_index": 2303,
                "end_index": 2392,
                "start_token": 12,
                "end_token": 31,
                "sent_num": 19,
                "id": 190
            },
            {
                "text": "קליפה_של__הוא של רומאן היסטורי, כביכול, אודיסיאה מודרנית, או אלתורים על מחזה פאסיון",
                "start_index": 2309,
                "end_index": 2392,
                "start_token": 14,
                "end_token": 31,
                "sent_num": 19,
                "id": 191
            },
            {
                "text": "_הוא",
                "start_index": 2318,
                "end_index": 2322,
                "start_token": 16,
                "end_token": 17,
                "sent_num": 19,
                "id": 192
            },
            {
                "text": "רומאן היסטורי, כביכול",
                "start_index": 2326,
                "end_index": 2347,
                "start_token": 18,
                "end_token": 22,
                "sent_num": 19,
                "id": 193
            },
            {
                "text": "רומאן היסטורי, כביכול, אודיסיאה מודרנית, או אלתורים על מחזה פאסיון",
                "start_index": 2326,
                "end_index": 2392,
                "start_token": 18,
                "end_token": 31,
                "sent_num": 19,
                "id": 194
            },
            {
                "text": "אודיסיאה מודרנית",
                "start_index": 2349,
                "end_index": 2365,
                "start_token": 23,
                "end_token": 25,
                "sent_num": 19,
                "id": 195
            },
            {
                "text": "אלתורים על מחזה פאסיון",
                "start_index": 2370,
                "end_index": 2392,
                "start_token": 27,
                "end_token": 31,
                "sent_num": 19,
                "id": 196
            },
            {
                "text": "מחזה פאסיון",
                "start_index": 2381,
                "end_index": 2392,
                "start_token": 29,
                "end_token": 31,
                "sent_num": 19,
                "id": 197
            },
            {
                "text": "כך",
                "start_index": 2427,
                "end_index": 2429,
                "start_token": 42,
                "end_token": 43,
                "sent_num": 19,
                "id": 198
            },
            {
                "text": "רומאן גדול אחר של_הוא",
                "start_index": 2438,
                "end_index": 2459,
                "start_token": 45,
                "end_token": 50,
                "sent_num": 19,
                "id": 199
            },
            {
                "text": "רומאן גדול אחר של_הוא, אולי אחד הרומאנים הגדולים שנכתבו בזמן מן הזמנים",
                "start_index": 2438,
                "end_index": 2508,
                "start_token": 45,
                "end_token": 64,
                "sent_num": 19,
                "id": 200
            },
            {
                "text": "_הוא",
                "start_index": 2455,
                "end_index": 2459,
                "start_token": 49,
                "end_token": 50,
                "sent_num": 19,
                "id": 201
            },
            {
                "text": "אחד הרומאנים הגדולים שנכתבו בזמן מן הזמנים, ב\"יורדי המרכבה\", ספר שמתחת לה_מעטה המיסטי של_הוא, הוא היגד עמוק ורב-עוצמה על האנטישמיות והשואה",
                "start_index": 2466,
                "end_index": 2604,
                "start_token": 52,
                "end_token": 96,
                "sent_num": 19,
                "id": 202
            },
            {
                "text": "זמן מן הזמנים",
                "start_index": 2495,
                "end_index": 2508,
                "start_token": 60,
                "end_token": 64,
                "sent_num": 19,
                "id": 203
            },
            {
                "text": "הזמנים",
                "start_index": 2502,
                "end_index": 2508,
                "start_token": 62,
                "end_token": 64,
                "sent_num": 19,
                "id": 204
            },
            {
                "text": "\"יורדי המרכבה\", ספר שמתחת לה_מעטה המיסטי של_הוא, הוא היגד עמוק ורב-עוצמה על האנטישמיות והשואה",
                "start_index": 2511,
                "end_index": 2604,
                "start_token": 66,
                "end_token": 96,
                "sent_num": 19,
                "id": 205
            },
            {
                "text": "יורדי המרכבה",
                "start_index": 2512,
                "end_index": 2524,
                "start_token": 67,
                "end_token": 70,
                "sent_num": 19,
                "id": 206
            },
            {
                "text": "ספר שמתחת לה_מעטה המיסטי של_הוא, הוא היגד עמוק ורב-עוצמה על האנטישמיות והשואה",
                "start_index": 2527,
                "end_index": 2604,
                "start_token": 72,
                "end_token": 96,
                "sent_num": 19,
                "id": 207
            },
            {
                "text": "ה_מעטה המיסטי של_הוא",
                "start_index": 2538,
                "end_index": 2558,
                "start_token": 76,
                "end_token": 82,
                "sent_num": 19,
                "id": 208
            },
            {
                "text": "_הוא",
                "start_index": 2554,
                "end_index": 2558,
                "start_token": 81,
                "end_token": 82,
                "sent_num": 19,
                "id": 209
            },
            {
                "text": "הוא",
                "start_index": 2560,
                "end_index": 2563,
                "start_token": 83,
                "end_token": 84,
                "sent_num": 19,
                "id": 210
            },
            {
                "text": "היגד עמוק ורב-עוצמה על האנטישמיות והשואה",
                "start_index": 2564,
                "end_index": 2604,
                "start_token": 84,
                "end_token": 96,
                "sent_num": 19,
                "id": 211
            },
            {
                "text": "האנטישמיות",
                "start_index": 2587,
                "end_index": 2597,
                "start_token": 91,
                "end_token": 93,
                "sent_num": 19,
                "id": 212
            },
            {
                "text": "האנטישמיות והשואה",
                "start_index": 2587,
                "end_index": 2604,
                "start_token": 91,
                "end_token": 96,
                "sent_num": 19,
                "id": 213
            },
