                "end_index": 2658,
                "start_token": 26,
                "end_token": 28,
                "sent_num": 27,
                "id": 197
            },
            {
                "text": "מה שברור",
                "start_index": 2661,
                "end_index": 2669,
                "start_token": 0,
                "end_token": 3,
                "sent_num": 28,
                "id": 198
            },
            {
                "text": "המלה האחרונה",
                "start_index": 2698,
                "end_index": 2710,
                "start_token": 11,
                "end_token": 15,
                "sent_num": 28,
                "id": 199
            },
            {
                "text": "העובדה כי הן ההלכה החדשה והן זו שבוטלה, התקבלו על חוד_של__הוא של קול",
                "start_index": 2713,
                "end_index": 2781,
                "start_token": 1,
                "end_token": 22,
                "sent_num": 29,
                "id": 200
            },
            {
                "text": "ההלכה החדשה",
