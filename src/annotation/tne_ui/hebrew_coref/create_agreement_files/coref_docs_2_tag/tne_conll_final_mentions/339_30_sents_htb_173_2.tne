                "end_index": 2559,
                "start_token": 36,
                "end_token": 39,
                "sent_num": 26,
                "id": 187
            },
            {
                "text": "_היא",
                "start_index": 2555,
                "end_index": 2559,
                "start_token": 38,
                "end_token": 39,
                "sent_num": 26,
                "id": 188
            },
            {
                "text": "ה_כנסת",
                "start_index": 2562,
                "end_index": 2568,
                "start_token": 1,
                "end_token": 3,
                "sent_num": 27,
                "id": 189
            },
            {
                "text": "הצעת חוק ברוח המחנה האחר, שהגיש ח\"כ שמעון שטרית ושעיקר_של__היא ביטול \"הלכת טובול\"",
                "start_index": 2578,
                "end_index": 2659,
                "start_token": 5,
                "end_token": 29,
                "sent_num": 27,
                "id": 190
            },
            {
                "text": "רוח המחנה האחר",
                "start_index": 2588,
                "end_index": 2602,
                "start_token": 8,
                "end_token": 13,
                "sent_num": 27,
                "id": 191
            },
            {
                "text": "המחנה האחר",
                "start_index": 2592,
                "end_index": 2602,
                "start_token": 9,
                "end_token": 13,
                "sent_num": 27,
                "id": 192
            },
            {
                "text": "ח\"כ שמעון שטרית",
