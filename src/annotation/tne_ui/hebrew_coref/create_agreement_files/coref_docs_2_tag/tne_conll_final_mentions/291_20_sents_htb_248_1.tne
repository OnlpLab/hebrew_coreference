            },
            {
                "text": "זוג",
                "start_index": 1675,
                "end_index": 1678,
                "start_token": 11,
                "end_token": 12,
                "sent_num": 17,
                "id": 132
            },
            {
                "text": "חצי קנקן של יין הבית",
