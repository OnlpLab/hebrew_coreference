                "end_index": 1579,
                "start_token": 13,
                "end_token": 14,
                "sent_num": 16,
                "id": 123
            },
            {
                "text": "די כסף לניהול מערכת הבחירות הטלוויזיונית היקרה, שבלעדי_היא אין פוליטיקאים אמריקאיים מסוגלים לנצח",
                "start_index": 1599,
                "end_index": 1695,
                "start_token": 19,
                "end_token": 39,
                "sent_num": 16,
                "id": 124
            },
            {
                "text": "ניהול מערכת הבחירות הטלוויזיונית היקרה, שבלעדי_היא אין פוליטיקאים אמריקאיים מסוגלים לנצח",
                "start_index": 1607,
                "end_index": 1695,
                "start_token": 22,
                "end_token": 39,
                "sent_num": 16,
                "id": 125
            },
            {
                "text": "מערכת הבחירות הטלוויזיונית היקרה, שבלעדי_היא אין פוליטיקאים אמריקאיים מסוגלים לנצח",
                "start_index": 1613,
                "end_index": 1695,
                "start_token": 23,
                "end_token": 39,
                "sent_num": 16,
                "id": 126
            },
            {
                "text": "_היא",
                "start_index": 1653,
                "end_index": 1657,
                "start_token": 33,
                "end_token": 34,
                "sent_num": 16,
                "id": 127
            },
            {
                "text": "פוליטיקאים אמריקאיים",
                "start_index": 1662,
                "end_index": 1682,
                "start_token": 35,
                "end_token": 37,
                "sent_num": 16,
                "id": 128
            },
            {
                "text": "חזקה על הארקין, שיצביע גם בה_עתיד בעד חוק סיוע החוץ",
                "start_index": 1697,
                "end_index": 1748,
                "start_token": 0,
                "end_token": 15,
                "sent_num": 17,
                "id": 129
            },
            {
                "text": "הארקין, שיצביע גם בה_עתיד בעד חוק סיוע החוץ",
