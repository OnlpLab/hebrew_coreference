                "start_index": 1554,
                "end_index": 1585,
                "start_token": 8,
                "end_token": 16,
                "sent_num": 16,
                "id": 120
            },
            {
                "text": "גבולות מדינה_של__הוא הקטנה",
                "start_index": 1559,
                "end_index": 1585,
                "start_token": 10,
                "end_token": 16,
                "sent_num": 16,
                "id": 121
            },
            {
                "text": "מדינה_של__הוא הקטנה",
