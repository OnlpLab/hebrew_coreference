                "end_token": 5,
                "sent_num": 12,
                "id": 90
            },
            {
                "text": "מנכ\"ל אייפא\"ק טום דאיין",
                "start_index": 1180,
                "end_index": 1203,
                "start_token": 3,
                "end_token": 7,
                "sent_num": 12,
                "id": 91
            },
            {
                "text": "אייפא\"ק",
                "start_index": 1186,
                "end_index": 1193,
                "start_token": 4,
                "end_token": 5,
                "sent_num": 12,
                "id": 92
            },
            {
                "text": "טום דאיין",
                "start_index": 1194,
                "end_index": 1203,
                "start_token": 5,
                "end_token": 7,
                "sent_num": 12,
                "id": 93
            },
            {
                "text": "הארקין",
                "start_index": 1207,
                "end_index": 1213,
                "start_token": 8,
                "end_token": 9,
                "sent_num": 12,
                "id": 94
            },
            {
                "text": "אחד מששה או שבעה סנאטורים, שנבחרו בזכות \"כסף יהודי\"",
                "start_index": 1215,
                "end_index": 1266,
                "start_token": 10,
                "end_token": 24,
                "sent_num": 12,
                "id": 95
            },
            {
                "text": "סנאטורים, שנבחרו בזכות \"כסף יהודי\"",
                "start_index": 1232,
                "end_index": 1266,
                "start_token": 15,
                "end_token": 24,
                "sent_num": 12,
                "id": 96
            },
            {
                "text": "כסף יהודי",
                "start_index": 1256,
                "end_index": 1265,
                "start_token": 21,
                "end_token": 23,
                "sent_num": 12,
                "id": 97
            },
            {
                "text": "זו",
                "start_index": 1268,
                "end_index": 1270,
                "start_token": 0,
                "end_token": 1,
                "sent_num": 13,
                "id": 98
            },
            {
                "text": "התרברבות לא-דיסקרטית",
                "start_index": 1276,
                "end_index": 1296,
                "start_token": 2,
                "end_token": 6,
                "sent_num": 13,
                "id": 99
            },
            {
                "text": "_היא",
                "start_index": 1316,
                "end_index": 1320,
                "start_token": 13,
                "end_token": 14,
                "sent_num": 13,
                "id": 100
            },
            {
                "text": "השנה",
                "start_index": 1321,
                "end_index": 1325,
                "start_token": 14,
                "end_token": 15,
                "sent_num": 13,
                "id": 101
            },
            {
                "text": "שתדלנים פרו-ישראליים בוואשינגטון",
                "start_index": 1340,
                "end_index": 1372,
                "start_token": 8,
                "end_token": 14,
                "sent_num": 14,
                "id": 102
            },
            {
                "text": "וואשינגטון",
                "start_index": 1362,
                "end_index": 1372,
                "start_token": 13,
                "end_token": 14,
                "sent_num": 14,
                "id": 103
            },
            {
                "text": "השבוע",
                "start_index": 1378,
                "end_index": 1383,
                "start_token": 15,
                "end_token": 16,
                "sent_num": 14,
                "id": 104
            },
            {
                "text": "ידיהם",
                "start_index": 1387,
                "end_index": 1392,
                "start_token": 17,
                "end_token": 19,
                "sent_num": 14,
                "id": 105
            },
            {
                "text": "הם",
                "start_index": 1390,
                "end_index": 1392,
                "start_token": 18,
                "end_token": 19,
                "sent_num": 14,
                "id": 106
            },
            {
                "text": "שביעות רצון",
                "start_index": 1394,
                "end_index": 1405,
                "start_token": 20,
                "end_token": 22,
                "sent_num": 14,
                "id": 107
            },
            {
                "text": "משמע הידיעה, שהארקין גבר על טוקי בהפרש משכנע של 10%",
                "start_index": 1407,
                "end_index": 1458,
                "start_token": 23,
                "end_token": 38,
                "sent_num": 14,
                "id": 108
            },
            {
                "text": "הידיעה, שהארקין גבר על טוקי בהפרש משכנע של 10%",
                "start_index": 1412,
                "end_index": 1458,
                "start_token": 24,
                "end_token": 38,
                "sent_num": 14,
                "id": 109
            },
            {
                "text": "הארקין",
                "start_index": 1421,
                "end_index": 1427,
                "start_token": 28,
                "end_token": 29,
                "sent_num": 14,
                "id": 110
            },
            {
                "text": "טוקי",
                "start_index": 1435,
                "end_index": 1439,
                "start_token": 31,
                "end_token": 32,
                "sent_num": 14,
                "id": 111
            },
            {
                "text": "הפרש משכנע של 10%",
                "start_index": 1441,
                "end_index": 1458,
                "start_token": 33,
                "end_token": 38,
                "sent_num": 14,
                "id": 112
            },
            {
                "text": "הוא",
                "start_index": 1460,
                "end_index": 1463,
                "start_token": 0,
                "end_token": 1,
                "sent_num": 15,
                "id": 113
            },
            {
                "text": "הסנאטור הדמוקרטי הראשון בתולדות איובה הנבחר לתקופת כהונה שנייה",
                "start_index": 1464,
                "end_index": 1526,
                "start_token": 1,
                "end_token": 16,
                "sent_num": 15,
                "id": 114
            },
            {
                "text": "תולדות איובה",
                "start_index": 1489,
                "end_index": 1501,
                "start_token": 8,
                "end_token": 10,
                "sent_num": 15,
                "id": 115
            },
            {
                "text": "איובה",
                "start_index": 1496,
                "end_index": 1501,
                "start_token": 9,
                "end_token": 10,
                "sent_num": 15,
                "id": 116
            },
            {
                "text": "תקופת כהונה שנייה",
                "start_index": 1509,
                "end_index": 1526,
                "start_token": 13,
                "end_token": 16,
                "sent_num": 15,
                "id": 117
            },
            {
                "text": "הוא",
                "start_index": 1528,
                "end_index": 1531,
                "start_token": 0,
                "end_token": 1,
                "sent_num": 16,
                "id": 118
            },
            {
